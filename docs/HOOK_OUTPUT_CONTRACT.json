{
  "version": 1,
  "purpose": "Host-neutral output behavior for hooks: clean or inapplicable results consume no context; findings are bounded and explain WHY and FIX.",
  "defaults": {
    "successStdout": "empty",
    "successStderr": "empty",
    "failureRequiredMarkers": ["WHY:", "FIX:"],
    "findingShape": "hookSpecificOutput.additionalContext",
    "maxFindingCharacters": 2000,
    "invalidInput": "silent_fail_open_unless_the_hook_is_a_canonical_hard_gate",
    "noisePolicy": "deduplicate within one invocation; rate-limit persistent reminders unless suppression weakens a safety boundary"
  },
  "pilot": [
    {
      "hook": "hooks/context-budget.sh",
      "event": "PreToolUse",
      "successProbe": {"tool_name": "Bash", "tool_input": {"command": "rg -m 20 TODO src"}},
      "findingProbe": {"tool_name": "Bash", "tool_input": {"command": "rg TODO ."}},
      "noiseControl": {
        "mode": "one_finding_per_invocation",
        "deduplicateBy": "risk-category",
        "persistentRateLimit": "not-needed: feedback is attached only to the exact risky call"
      }
    },
    {
      "hook": "hooks/careful.sh",
      "event": "PreToolUse",
      "successProbe": {"tool_name": "Bash", "tool_input": {"command": "git status --short"}},
      "findingProbe": {"tool_name": "Bash", "tool_input": {"command": "git reset --hard HEAD~1"}},
      "probeEnv": {"CAREFUL_MODE": "1"},
      "noiseControl": {
        "mode": "one_finding_per_invocation",
        "deduplicateBy": "destructive-pattern",
        "persistentRateLimit": "safety-exception: do not suppress a distinct destructive call"
      }
    }
  ]
}
