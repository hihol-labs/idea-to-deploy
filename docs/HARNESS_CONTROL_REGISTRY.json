{
  "version": 1,
  "purpose": "Lifecycle registry for load-bearing harness controls. A control is earned only by one production incident, repeated independent signals, or a hard external constraint; it remains removable when its assumption no longer holds.",
  "admissionPolicy": {
    "allowedEvidenceTypes": ["production_incident", "repeated_independent_signals", "hard_external_constraint"],
    "minimumIndependentSignals": 2,
    "singleSignalAllowedOnlyFor": "production_incident",
    "prohibited": [
      "model intuition without durable evidence",
      "a metric produced only by the control being proposed",
      "an unbounded rule with no retirement condition"
    ],
    "decisionAuthority": "human"
  },
  "controls": [
    {
