      "assumption": "A capable model can skip the applicable lifecycle workflow under time pressure.",
      "expectedBehavior": "Repeated unacknowledged direct mutations become an explicit skill invocation or a durable bypass reason.",
      "enforcedBy": ["hooks/check-tool-skill.sh", "hooks/check-skills.sh"],
      "verifiedBy": ["tests/verify_skill_enforcement.py", "tests/verify_v147_fixes.py"],
      "reviewBy": "2026-10-29",
      "retireWhen": "A reversible disabled-vs-enabled benchmark shows equal workflow selection and no increase in unacknowledged bypasses across at least 30 eligible tasks.",
      "disableEnv": {"ITD_TOOL_SKILL_GATE": "0"},
      "costAndNoiseEvidence": ["skills/retro/SKILL.md"]
    },
    {
