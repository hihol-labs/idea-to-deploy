[Unit]
Description=Idea to Deploy independent review broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=itd-review
Group=itd-review
WorkingDirectory=/opt/itd-review-broker
StateDirectory=itd-review-broker
StateDirectoryMode=0700

LoadCredentialEncrypted=github-app-private-key:/etc/credstore.encrypted/itd-github-app-private-key
LoadCredentialEncrypted=github-webhook-signing:/etc/credstore.encrypted/itd-github-webhook-secret
LoadCredentialEncrypted=provenance-keyring:/etc/credstore.encrypted/itd-provenance-keyring
LoadCredentialEncrypted=openai-service-account-key:/etc/credstore.encrypted/itd-openai-service-account-key

Environment=PYTHONPATH=/opt/itd-review-broker
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ITD_GITHUB_APP_CLIENT_ID=REPLACE_WITH_REAL_CLIENT_ID
Environment=ITD_GITHUB_APP_PRIVATE_KEY_FILE=%d/github-app-private-key
Environment=ITD_GITHUB_WEBHOOK_SECRET_FILE=%d/github-webhook-signing
Environment=ITD_PROVENANCE_KEYRING_FILE=%d/provenance-keyring
Environment=ITD_OPENAI_API_KEY_FILE=%d/openai-service-account-key
Environment=ITD_BROKER_DATABASE=%S/itd-review-broker/review-broker.sqlite3
Environment=ITD_BROKER_HOST=127.0.0.1
Environment=ITD_BROKER_PORT=8080

ExecStart=/opt/itd-review-broker/venv/bin/python -m services.review_broker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=%S/itd-review-broker
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
